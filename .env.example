# CHRONEX Environment Configuration
# Copy this file to .env and customize for your deployment
# NEVER commit .env to git

# Maximum CSV upload size in megabytes (default: 500)
CHRONEX_MAX_UPLOAD_MB=500

# Backend server host and port
# CHRONEX_HOST=0.0.0.0
# CHRONEX_PORT=8000

# Frontend API base URL (only needed if building for production deployment)
# VITE_API_BASE_URL=http://localhost:8000/api

